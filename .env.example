NEXO_HOST=127.0.0.1
NEXO_PORT=8000
NEXO_DATA_DIR=data
NEXO_SECRET=
NEXO_TOKEN_HOURS=8
NEXO_ALLOW_REGISTRATION=true
NEXO_MAX_UPLOAD_MB=100
NEXO_DATABASE_URL=

NEXO_LLM_PROVIDER=ollama
NEXO_LLM_MODEL=llama3.1
NEXO_LLM_TEMPERATURE=0.1
NEXO_LLM_TIMEOUT=120
NEXO_OLLAMA_URL=http://localhost:11434
NEXO_OPENAI_BASE_URL=
OPENAI_API_KEY=

NEXO_EMBED_PROVIDER=huggingface
NEXO_EMBED_MODEL=intfloat/multilingual-e5-small
NEXO_EMBED_QUERY_PREFIX="query: "
NEXO_EMBED_TEXT_PREFIX="passage: "

NEXO_VECTOR_STORE=chroma
NEXO_COLLECTION=nexo_trechos
NEXO_CHROMA_HOST=
NEXO_CHROMA_PORT=8001
NEXO_QDRANT_URL=
NEXO_QDRANT_API_KEY=

NEXO_RERANKER=huggingface
NEXO_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
NEXO_COHERE_MODEL=rerank-v3.5
COHERE_API_KEY=

NEXO_CHUNK_SIZE=512
NEXO_CHUNK_OVERLAP=64
NEXO_TOP_K=12
NEXO_TOP_N=4
NEXO_MIN_SIMILARITY=0.15
NEXO_MIN_RERANK_SCORE=0.1
NEXO_HISTORY_TURNS=3
NEXO_VERIFY_ANSWERS=false
